# Copy to secrets.env (git-ignored) and fill in. Every service reads
# DATABASE_URL; identity and the gateway read the GitHub variables
# (CONTRACT.md §18, docs/github-app.md).
DATABASE_URL=postgres://sdi:CHANGE-ME@postgres:5432/sdi
POSTGRES_PASSWORD=CHANGE-ME
# 32+ bytes: `openssl rand -hex 32`. Signs session tokens and encrypts
# stored OAuth tokens and reasoner keys.
SDI_SESSION_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM, or the PEM base64-encoded on one line.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Dev-mode fallback only (SDI_DEV_LOGIN=1); leave empty in production.
GITHUB_TOKEN=
# Optional instance-wide model key (CONTRACT.md §19): LLM_API_KEY for the
# provider named by LLM_PROVIDER in kustomization.yaml. ANTHROPIC_API_KEY is
# the older name for an Anthropic key and still works.
LLM_API_KEY=
ANTHROPIC_API_KEY=
