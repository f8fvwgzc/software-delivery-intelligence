# Copy to .env (git-ignored). scripts/dev.sh sources it after taking
# GITHUB_TOKEN from `gh auth token`, and docker compose interpolates it.
# Leave a line commented rather than empty: an empty GITHUB_TOKEN= here
# overrides the one dev.sh just exported.

# GitHub token, used by two services:
#   knowledge  reads repositories, workflows, runs and deployments
#   execution  the `github` adapter opens pull requests (docs/adapters.md)
# Reading needs a classic PAT with `repo` (private repositories) or a
# fine-grained token with Contents/Metadata/Actions/Deployments: read.
# Opening pull requests additionally needs Contents and Pull requests: write
# on the repository (classic `repo` already covers it).
#GITHUB_TOKEN=

# Optional. When set, negotiation replies and failure diagnoses are written
# by Claude from the structured context. Ranking stays deterministic.
#ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

DATABASE_URL=postgres://sdi:sdi@127.0.0.1:5440/sdi

# Identity service (CONTRACT.md §18). Identity is GitHub: there are no SDI
# passwords. Two ways in:
#   dev login   scripts/dev.sh exports SDI_DEV_LOGIN=1 and a generated
#               SDI_SESSION_SECRET (kept in .run/session-secret); /auth/login
#               then creates a local session for the GITHUB_TOKEN account.
#   GitHub      register an OAuth app (individuals) and/or the SDI GitHub
#               App (organisations): docs/github-app.md.
# Compose never generates anything: set SDI_SESSION_SECRET here for `make up`.

# 32+ bytes; signs session tokens and encrypts stored OAuth tokens and
# reasoner keys. Rotating it signs everyone out and invalidates stored keys.
#   openssl rand -hex 32
#SDI_SESSION_SECRET=
# Public origin of the web app: OAuth callback target, `returnTo` allow-list,
# cookie host. Default: http://localhost (compose), http://127.0.0.1:5173 (dev).
#SDI_PUBLIC_URL=https://sdi.example.com
# 1 enables the local dev login when the OAuth variables are absent. Never
# set this on an instance other people can reach.
#SDI_DEV_LOGIN=1
# GitHub OAuth app (Settings → Developer settings → OAuth Apps), callback
# URL <SDI_PUBLIC_URL>/api/v1/auth/callback.
#GITHUB_OAUTH_CLIENT_ID=
#GITHUB_OAUTH_CLIENT_SECRET=
# SDI GitHub App (docs/github-app.md). The private key is the PEM GitHub
# generates; paste it base64-encoded on one line (`base64 < key.pem | tr -d '\n'`)
# or mount it and read it in with `GITHUB_APP_PRIVATE_KEY="$(cat key.pem)"`.
#GITHUB_APP_ID=
#GITHUB_APP_SLUG=
#GITHUB_APP_PRIVATE_KEY=
# Shared secret the App signs every webhook delivery with (X-Hub-Signature-256).
#GITHUB_WEBHOOK_SECRET=
# Identity's gRPC address for the gateway, knowledge and execution; set only
# when identity runs elsewhere (compose uses http://identity:50054).
#IDENTITY_GRPC_URL=http://127.0.0.1:50054

# Execution service, `docker` adapter (CONTRACT.md §3).
# Where checkouts and build contexts go. On the host it defaults to .run/
# (git-ignored); in compose it is a named volume and this value is ignored.
#SDI_RUN_DIR=.run
# Only when the daemon is not on its default socket. On the host the CLI
# default applies; compose passes the variable through to execution when
# set, which is how to use a remote daemon instead of the local-exec relay.
#DOCKER_HOST=

# Compose only.
#SDI_HTTP_PORT=80
#SDI_TAG=local
# Same as `make up-local-exec`: the execution container gets this host's
# Docker socket and can start containers on it. Developer machines only.
#COMPOSE_PROFILES=local-exec

# --- Capacity and bounds (docs/self-hosting.md §9); the defaults fit a
# small instance. Five services × DB_MAX_CONNECTIONS must fit Postgres'
# max_connections (100 by default).
#DB_MAX_CONNECTIONS=20
#DB_STATEMENT_TIMEOUT_MS=30000
#GATEWAY_AUTH_CACHE_MAX=10000
#SSE_MAX_PER_WORKSPACE=50
#WEBHOOK_QUEUE_MAX=256
#SCAN_STAGE_TIMEOUT_SECS=600
#SCAN_TIMEOUT_SECS=1800
#SHUTDOWN_GRACE_SECS=10
