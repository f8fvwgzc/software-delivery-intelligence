# Copy to .env (git-ignored). scripts/dev.sh sources it.

# Read-only GitHub token (classic PAT with `repo`, or fine-grained with
# Contents/Metadata/Actions/Deployments read). Falls back to `gh auth token`.
GITHUB_TOKEN=

# Optional. When set, negotiation replies and failure diagnoses are written by
# Claude from the structured context. Ranking stays deterministic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

DATABASE_URL=postgres://sdi:sdi@127.0.0.1:5440/sdi
